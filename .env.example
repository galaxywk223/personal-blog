PUBLIC_SITE_URL=https://example.com
PUBLIC_WALINE_SERVER_URL=https://example.com/api/waline
DATABASE_URL=postgresql://blog:replace-with-a-long-random-password@127.0.0.1:5432/kailog
SITE_DOMAIN=example.com
SITE_NAME=KaiLog
POSTGRES_DB=waline
POSTGRES_USER=waline
POSTGRES_PASSWORD=replace-with-a-long-random-password
WALINE_JWT_TOKEN=replace-with-another-long-random-string
ADMIN_INITIAL_USERNAME=admin
# Bootstrap only: existing database accounts are never overwritten.
ADMIN_PASSWORD_HASH=generate-with-npm-run-admin-hash
ADMIN_SESSION_SECRET=replace-with-a-long-random-session-secret
ADMIN_BASE_URL=/admin/
