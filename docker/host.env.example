# Host Caddy deployment: copy to the project root as .env.
PG_ROOT_PASSWORD=replace-with-independent-random-password
BLOG_DB_PASSWORD=replace-with-blog-database-password
WALINE_DB_PASSWORD=replace-with-waline-database-password
DATABASE_URL=postgresql://kailog:replace-with-blog-database-password@postgres:5432/kailog
ADMIN_SESSION_SECRET=replace-with-independent-session-secret
WALINE_JWT_TOKEN=replace-with-independent-waline-secret
PUBLIC_SITE_URL=https://blog.example.com
PUBLIC_WALINE_SERVER_URL=https://blog.example.com/api/waline
SITE_DOMAIN=blog.example.com
SITE_NAME=KaiLog
BLOG_HTTP_PORT=18081
NODE_ENV=production
NODE_OPTIONS=--max-old-space-size=1536
TZ=Asia/Shanghai
# First database only; omit bootstrap credentials when restoring admin_users.
# ADMIN_INITIAL_USERNAME=admin
# ADMIN_PASSWORD_HASH=generate-with-npm-run-admin-hash
